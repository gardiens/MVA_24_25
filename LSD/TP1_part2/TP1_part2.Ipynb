            "source": [
                "def forward_backward(x0,gamma,lambda_n,y,beta,num_iter,verbose=True):\n",
                "    x_n=x0\n",
                "    y_n=x0\n",
                "    f=f_square_norm(K,y,gamma=gamma)\n",
                "    g=g_entropy(gamma=gamma*beta)\n",
                "    loss=[]\n",
                "    for n in range(num_iter):\n",
                "        y_n=x_n-gamma*f.grad(x=x_n)\n",
                "        x_n=x_n+lambda_n[n]*(g.proximal(x=y_n)-x_n)\n",
                "        if n%10000==0 and verbose:\n",
                '            print("iteration",n,"the loss is",f(x_n)+g(x_n))\n',
                "        loss.append(f(x_n)+g(x_n))\n",
                "\n",
                '        #print("iteration",n,"the loss is",f(x_n)+g(x_n))#"loss f",f(x_n),"loss g",g(x_n))\n',
                "    return x_n, loss, 2*g(x_n)",
            ],
        },
        {
            "cell_type": "code",
            "execution_count": 53,
            "metadata": {},
            "outputs": [],
            "source": [
                "def douglas_rachford(x0,gamma,lambda_n,y,beta,num_iter,verbose=True):\n",
                "    x_n=x0\n",
                "    y_n=x0\n",
                "    g=f_square_norm(K,y,gamma=gamma)\n",
                "    f=g_entropy(gamma=gamma*beta)\n",
                "    loss=[]\n",
                "    for n in range(num_iter):\n",
                "        y_n=g.proximal(x=x_n)\n",
                "        z_n=f.proximal(x=2*y_n - x_n)\n",
                "        x_n=x_n+lambda_n[n]*(z_n - y_n)\n",
                "        if n%10000==0 and verbose:\n",
                '            print("iteration",n,"the loss is",f(x_n)+g(x_n))\n',
                "        loss.append(f(x_n)+g(x_n))\n",
                "\n",
                '        #print("iteration",n,"the loss is",f(x_n)+g(x_n))#"loss f",f(x_n),"loss g",g(x_n))\n',
                "    return z_n,loss",
            ],
        },
        {
