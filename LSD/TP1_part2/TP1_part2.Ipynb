            "source": [
                "class f_square_norm(fun_minimize):\n",
                "    def __init__(self,K,y,gamma=1):\n",
                "        self.K=K\n",
                "        self.y=y \n",
                "        self.gamma=gamma\n",
                "        self.inv_id_gamma_ll = np.linalg.inv(np.eye(K.shape[1]) + self.gamma*K.T @ K)\n",
                "        return\n",
                '    def grad(self,x:"np.array")->"np.array":\n',
                "        return self.K.T @ (self.K @ x -self.y )\n",
                '    def proximal(self,x:"np.array")->"np.array":\n',
                "        return self.inv_id_gamma_ll @ (x + self.gamma * K.T @ self.y)\n",
                "    def __call__(self,x):\n",
                "        return 1/2*np.linalg.norm(self.K @ x -self.y)**2\n",
                "\n",
                "x_test=np.zeros(N)\n",
                "f=f_square_norm(K,y)\n",
                "print(f.grad(x_test).shape)\n",
            ],
