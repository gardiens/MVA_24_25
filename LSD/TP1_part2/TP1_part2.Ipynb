            "source": [
                "from scipy.special import lambertw\n",
                "\n",
                "def entropy(x):\n",
                "    if np.any(x < 0):\n",
                "        return np.inf \n",
                "\n",
                "    phi = np.where(x > 0, x * np.log(np.maximum(x, 1e-10)), 0)\n",
                "\n",
                "    return np.sum(phi)\n",
                "\n",
                "class g_entropy(fun_minimize):\n",
                "    def __init__(self,gamma):\n",
                "        self.gamma=gamma\n",
                "        return\n",
                "    \n",
                '    def proximal(self,x:"np.array")->"np.array":\n',
                "        prox = np.zeros_like(x)\n",
                "        for i in range(len(x)):\n",
                "            u = (x[i] / self.gamma) - 1 - np.log(self.gamma)\n",
                "            if u > 100:\n",
                "                prox[i] = self.gamma * (u - np.log(u))\n",
                "            else:\n",
                "                prox[i] = self.gamma * lambertw(np.exp(u)).real\n",
                "        return prox\n",
                "    \n",
                "    def __call__(self,x):\n",
                "        return entropy(x)\n",
                "\n",
                "# random vectors\n",
                "x_test=np.random.rand(N)\n",
                "gamma_test=0.1\n",
                "g1_test=g_entropy(gamma_test)\n",
                "print(g1_test.proximal(x_test).shape)\n",
                "print(g1_test(x_test))",
            ],
