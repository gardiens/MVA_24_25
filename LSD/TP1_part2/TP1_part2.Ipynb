            "source": [
                "def construct_K(T,t):\n",
                "    M=len(t)\n",
                "    N=len(T)\n",
                "    K=np.zeros((M,N))\n",
                "    for m in range(M):\n",
                "        for n in range(N):\n",
                "            K[m,n]=np.exp(-T[n]*t[m])\n",
                "    return K \n",
                "K=construct_K(T,t)",
