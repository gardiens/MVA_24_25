                "## Step 2: Create T using exponential sampling strategy\n",
                "def construct_T(N=200):\n",
                "    T_min=1\n",
                "    T_max=1000\n",
                "    T=np.zeros(N)\n",
                "    for k in range(N):\n",
                "        T[k]=T_min*np.exp(-(k)*np.log(T_min/T_max)/(N-1))\n",
                "    return T\n",
                "T=construct_T(N)\n",
            ],
        },
