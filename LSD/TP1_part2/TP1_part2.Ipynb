                "from tqdm import tqdm\n",
                "\n",
                "betas = np.logspace(-6, -2, 20)\n",
                "errors_fb = []\n",
                "errors_dr = []\n",
                "\n",
                "for beta in tqdm(betas):\n",
                "    x_chap_entropy_fb,loss, _=forward_backward(x0=x0,gamma=gamma,lambda_n=lambda_n,y=y,beta=beta,num_iter=num_iter,verbose=False)\n",
