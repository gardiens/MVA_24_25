            "cell_type": "code",
            "execution_count": 33,
            "metadata": {},
            "outputs": [],
            "source": [
                " # Construct D \n",
                "def construct_D(N):\n",
                "    D=np.zeros((N,N))\n",
                "    for n in range(N):\n",
                "        D[n,n]=1\n",
                "        D[n,(n-1)%N]=-1\n",
                "    return D\n",
                "D=construct_D(N)\n",
