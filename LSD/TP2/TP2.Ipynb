            "metadata": {},
            "source": ["# 1 X-ray tomography"],
        },
        {
            "cell_type": "markdown",
            "id": "cadc66a877a1301b",
            "metadata": {},
            "source": [
                "## 1.1 & 2.1 Download the projection matrix H and the image x available on the website. Use loadmat from scipy.io in Python to load the arrays, note that H is stored as a sparse matrix."
            ],
        },
        {
            "cell_type": "code",
            "id": "initial_id",
            "metadata": {
                "collapsed": true,
                "ExecuteTime": {
                    "end_time": "2025-01-27T18:03:07.532348Z",
                    "start_time": "2025-01-27T18:03:07.105010Z",
                },
            },
            "source": [
                "import numpy as np\n",
                "import scipy.io\n",
                "import scipy.sparse\n",
                "import matplotlib.pyplot as plt\n",
                "import time\n",
                "\n",
                "# Load the sparse matrix H\n",
                "H_data = scipy.io.loadmat('./data/H.mat')\n",
                "H_sparse = scipy.sparse.csr_matrix(H_data['H'])  # Convert COO format to a sparse matrix\n",
                "\n",
                "x_data = scipy.io.loadmat('./data/x.mat')  \n",
                "x = x_data['x']\n",
                "\n",
                "G_data = scipy.io.loadmat('./data/G.mat')\n",
                "G_sparse = scipy.sparse.csr_matrix(G_data['G'])\n",
                "\n",
                'print(f"Shape of H: {H_sparse.shape}")\n',
                'print(f"Shape of x: {x.shape}")\n',
                'print(f"Shape of G: {G_sparse.shape}")\n',
                "\n",
                "N = 90\n",
                "M = 180",
            ],
            "outputs": [
                {
                    "name": "stdout",
                    "output_type": "stream",
                    "text": [
                        "Shape of H: (16200, 8100)\n",
                        "Shape of x: (8100, 1)\n",
                        "Shape of G: (16200, 8100)\n",
                    ],
                }
            ],
            "execution_count": 1,
        },
        {
            "cell_type": "markdown",
            "id": "84b305d4f211e24a",
            "metadata": {},
            "source": ["## 1.2 Construct y, according to model (1), using sigma = 1"],
        },
        {
            "cell_type": "code",
            "id": "72c820243aa6875a",
            "metadata": {
                "ExecuteTime": {
                    "end_time": "2025-01-27T18:03:07.546609Z",
                    "start_time": "2025-01-27T18:03:07.541133Z",
                }
            },
            "source": [
                "def construct_y(sigma=1):\n",
                "    y_truth = H_sparse @ x\n",
                "    w = np.random.random(y_truth.shape)\n",
                "    y_noised = y_truth + sigma * w\n",
                "    return y_truth, y_noised, w\n",
                "\n",
                "y_unnoised,y,w = construct_y()\n",
                "\n",
                "print(y_unnoised.shape)",
            ],
            "outputs": [
                {"name": "stdout", "output_type": "stream", "text": ["(16200, 1)\n"]}
            ],
            "execution_count": 2,
        },
        {
