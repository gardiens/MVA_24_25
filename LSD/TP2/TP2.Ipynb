            "source": [
                "\n",
                "\n",
                "def SNR(x,x_restored):\n",
                "    norm_x = np.linalg.norm(x.flatten())\n",
                "    norm_delta = np.linalg.norm(x.flatten()-x_restored.flatten())\n",
                "    return 10 * (np.log(norm_x ) - np.log(norm_delta))\n",
                "\n",
                "\n",
                "\n",
                "def HP_tuning(delta_init,lambda_val_init, geometric_rate=0.9, eps=1e-1, tmax=20):\n",
                "    \n",
                "    \n",
                "    sigma = 4*np.array([delta_init, lambda_val_init])\n",
                "    best_f = -np.inf\n",
                "    last_f = np.inf\n",
                "    current_f = 0\n",
                "    hyper_params = np.array([delta_init,lambda_val_init ])\n",
                "    it=0\n",
                "    noised_lambda_delta=  hyper_params.copy()\n",
                "    while np.abs(last_f - current_f) > eps:\n",
                "        \n",
                "        x_restaured,history,_,L_time = test_grad_descend(tmax=tmax, lambda_val = noised_lambda_delta[0], delta=noised_lambda_delta[1])\n",
                "        last_f = current_f\n",
                "        current_f = SNR(x, x_restaured )\n",
                '        print(f"Loop {it} Update :")\n',
                '        print("Current sigmas", sigma)\n',
                '        print("SNR : ", current_f)\n',
                "        if best_f<current_f :\n",
                "            x_restaured_best= x_restaured\n",
                "            hyper_params = noised_lambda_delta\n",
                '            print("New Best")\n',
                '            print("new params :", hyper_params)\n',
                "            best_f = current_f\n",
                "        it+=1\n",
                "        \n",
                "        sigma *=geometric_rate\n",
                "        noised_lambda_delta=  np.random.normal(hyper_params, sigma)\n",
                "    return x_restaured_best,lambda_val, delta\n",
                "\n",
                "x_restaured,lambda_val,delta = HP_tuning(delta, lambda_val, tmax=15)\n",
                'check_results(x_restaured, y, "Gradient descent")\n',
            ],
