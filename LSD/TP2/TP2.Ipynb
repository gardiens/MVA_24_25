        {
            "cell_type": "markdown",
            "id": "5c384501c03b4f16",
            "metadata": {},
            "source": ["## 3.3 3MG algorithm"],
        },
        {
            "cell_type": "markdown",
            "id": "ba428181",
            "metadata": {},
            "source": ["### 3.3.1. Implement the 3MG algorithm."],
        },
        {
            "cell_type": "code",
            "id": "f398fe63a1de29af",
            "metadata": {
                "ExecuteTime": {
                    "end_time": "2025-01-27T18:04:11.613497Z",
                    "start_time": "2025-01-27T18:03:51.207948Z",
                }
            },
            "source": [
                "# 3MG Algorithm\n",
                "def _3mg_algorithm(grad_fun, metric_fun, stopping_criterion, quadratic_operator, theta=1):\n",
                "    x0 = np.zeros((N**2,1))\n",
                "\n",
                "    history_f = [metric_fun(x0)]\n",
                "    history_df = [grad_fun(x0)]\n",
                "\n",
                "    x = x0\n",
                "    t = 0\n",
                "    D_k = grad_fun(x)  # Initial D_k is the gradient at x0\n",
                "    timer = Timer()\n",
                "    L_time = [timer()]\n",
                "    while stopping_criterion((history_df[-1], L_time[-1])):\n",
                "        grad_x = grad_fun(x)\n",
                "\n",
                "        if t > 0:\n",
                "            D_k = np.hstack((-1*grad_x, x - history_x))\n",
                "\n",
                "        A_x = quadratic_operator(x)\n",
                "        D_k_T_A_x_D_k = D_k.T @ (A_x @ D_k)\n",
                "        D_k_T_grad_x = D_k.T @ grad_x\n",
                "        u_k = -1*scipy.linalg.pinv(D_k_T_A_x_D_k) @ D_k_T_grad_x\n",
                "\n",
                "        delta_x = D_k @ u_k\n",
                "        x = x + theta * delta_x\n",
                "\n",
                "        history_x = x.copy()\n",
                "        history_df.append(grad_x)\n",
                "        history_f.append(metric_fun(x))\n",
                "        t += 1\n",
                "        L_time.append(timer())\n",
                "\n",
                "    return x, history_f,history_df,L_time\n",
                "\n",
                "\n",
                "def test_3mg_algorithm(tmax=20,lambda_val = lambda_val, delta=delta):\n",
                "    stopping_criterion = lambda x : np.linalg.norm(x[0]) > np.sqrt(N)*1e-4 and x[1] <tmax\n",
                "    metric_fun = lambda x : f(x,y,G_sparse,H_sparse,lambda_val = lambda_val, delta=delta)\n",
                "    grad_fun = lambda x : gradient_f(x, H_sparse, G_sparse, y,lambda_val = lambda_val, delta=delta)\n",
                "    x_restaured,history,history_df,L_time = _3mg_algorithm(grad_fun, metric_fun,stopping_criterion, compute_curvate,theta=1)\n",
                "    return x_restaured,history,history_df,L_time\n",
                "    \n",
                "x_restaured,history,history_df,L_time = test_3mg_algorithm()\n",
                "plt.plot(L_time,history)\n",
                'plt.xlabel("time (s)")\n',
                'plt.ylabel("f values")\n',
                "plt.yscale('log')\n",
                "plt.xscale('log')\n",
                'plt.title("f over time")\n',
                "plt.show()\n",
                'plt.plot(L_time,np.linalg.norm(np.array(history_df), axis=1), label="norm of grad")\n',
                'plt.plot((L_time[0], L_time[-1]), np.sqrt(N)*1e-4 * np.ones((2,)), label="constraint")\n',
                'plt.xlabel("time (s)")\n',
                'plt.ylabel("norm_of_grad")\n',
                "plt.yscale('log')\n",
                "plt.legend()\n",
                'plt.title("norm of grad over time")\n',
                "plt.show()\n",
                "\n",
                "\n",
                'print("last f value", history[-1])\n',
                "\n",
                'check_results(x_restaured, y, "3MG")',
            ],
