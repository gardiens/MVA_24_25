            "id": "b3db8a37ca16e8a3",
            "metadata": {},
            "source": ["## 3.4 Block-coordinate MM quadratic algorithm"],
        },
        {
            "cell_type": "markdown",
            "id": "0d15cd37",
            "metadata": {},
            "source": "### 3.4.1 Create a function which gives, as an output, matrix $A_j(x) \\in {\\mathbb R}^{Nj \\times Nj}$  containing only the lines and rows of A(x) with indexes Jj .",
        },
        {
            "cell_type": "code",
            "id": "5aed748a68de1abb",
            "metadata": {
                "ExecuteTime": {
                    "end_time": "2025-01-27T18:04:11.627809Z",
                    "start_time": "2025-01-27T18:04:11.624804Z",
                }
            },
            "source": [
                "def compute_curvate_restricted(x, j,Nj,lambda_val = lambda_val, delta=delta):\n",
                '    """\n',
                "    j go from 0 to N/Nj -1.\n",
                '    """\n',
                "    indexes = np.arange(Nj*j, (j+1)*Nj)\n",
                "    G_sparse_res = G_sparse[:,indexes]\n",
                "    l2_term = HT_H[indexes,:][:,indexes]\n",
                "    diag = scipy.sparse.diags([omega(G_sparse_res @ x, delta=delta).flatten()], offsets=[0]).tocsc()\n",
                "    reg_term = G_sparse_res.T  @  diag @ G_sparse_res\n",
                "    A = l2_term + lambda_val * reg_term\n",
                "    return A\n",
                "\n",
                "class CurvatureRestrictedWrapper:\n",
                "    def __init__(self, Nj):\n",
                "        self.Nj=Nj \n",
                "        self.J= N**2 // self.Nj\n",
                "        self.j=0\n",
                "    \n",
                "    @property\n",
                "    def indexes(self):\n",
                "        return np.arange(self.Nj*self.j, (self.j+1)*self.Nj)\n",
                "    def compute_curvate_restricted(self, x):\n",
                "        return compute_curvate_restricted(x, self.j, self.Nj,lambda_val = lambda_val, delta=delta)\n",
                "    def update_j(self, j):\n",
                "        self.j = j\n",
                "    def matvec(self, x):\n",
                "        indexes = self.indexes\n",
                "        return self.compute_curvate_restricted(x) @ x\n",
                "    def rmatvec(self, x):\n",
                "        return self.matvec(x)\n",
            ],
            "outputs": [],
            "execution_count": 13,
        },
        {
            "cell_type": "markdown",
            "id": "e696e481",
            "metadata": {},
            "source": [
                "## 3.4.2 Deduce an implementation of a block coordinate MM quadratic algorithm for minimizing f . Test it for Nj = N=K with K 2 f1; 2; 3; 5; 6; 9g."
            ],
        },
        {
            "cell_type": "code",
            "id": "6844828d37d2be63",
            "metadata": {
                "ExecuteTime": {
                    "end_time": "2025-01-27T18:05:54.510649Z",
                    "start_time": "2025-01-27T18:04:11.669936Z",
                }
            },
            "source": [
                "# Block MM Algorithm\n",
                "def block_mm_algorithm(grad_fun, metric_fun,stopping_criterion,quadratic_operator, curv_wrapper:CurvatureRestrictedWrapper,theta=1):\n",
                "    J = curv_wrapper.J\n",
                "    x0 = np.zeros((N**2,1))\n",
                "    \n",
                "    history_f = [metric_fun(x0)]\n",
                "    history_df = [grad_fun(x0)]\n",
                "    x=x0\n",
                "    t=0\n",
                "    timer = Timer()\n",
                "    L_time = [timer()]\n",
                "    while stopping_criterion((history_df[-1], L_time[-1])):\n",
                "        j=t % J\n",
                "        curv_wrapper.update_j(j)\n",
                "        indexes = curv_wrapper.indexes\n",
                "        grad_x  = grad_fun(x)[indexes,:]\n",
                "        delta_x, info = scipy.sparse.linalg.bicg(quadratic_operator, -grad_x, maxiter=3)\n",
                "        delta_x = delta_x[:,np.newaxis]\n",
                "        \n",
                "        x[indexes] = x[indexes] + theta * delta_x\n",
                "        history_df.append(grad_x)\n",
                "        history_f.append(metric_fun(x))\n",
                "        t+=1\n",
                "        L_time.append(timer())\n",
                "        \n",
                "    return x,history_f,history_df,L_time\n",
                "\n",
                "\n",
                "def test_block_mm_algorithm(Nj,tmax=20,lambda_val = lambda_val, delta=delta):\n",
                "    stopping_criterion = lambda x : np.linalg.norm(x[0]) > np.sqrt(N)*1e-4 and x[1] <tmax\n",
                "    metric_fun = lambda x : f(x,y,G_sparse,H_sparse,lambda_val = lambda_val, delta=delta)\n",
                "    grad_fun = lambda x : gradient_f(x, H_sparse, G_sparse, y,lambda_val = lambda_val, delta=delta)\n",
                "    curv_wrapper = CurvatureRestrictedWrapper(Nj)\n",
                "    A_operator = scipy.sparse.linalg.LinearOperator((Nj,Nj), matvec=curv_wrapper.matvec, rmatvec=curv_wrapper.rmatvec)\n",
                "    x_final,history,history_df, L_time = block_mm_algorithm(grad_fun, metric_fun,stopping_criterion, A_operator, curv_wrapper,theta=1)\n",
                "    return x_final,history, history_df,L_time\n",
                "\n",
                "infos = {}\n",
                "K_values = [2,3,5,7,9]\n",
                "for K in K_values:\n",
                "    Nj = N**2 // K\n",
                "\n",
                "    infos[K] = test_block_mm_algorithm(Nj)\n",
                "\n",
                "for K in K_values:\n",
                '    plt.plot(infos[K][-1],infos[K][1], label=f"K={K}")\n',
                'plt.xlabel("time (s)")\n',
                'plt.ylabel("f values")\n',
                'plt.title("f over time")\n',
                "plt.legend()\n",
                "plt.yscale('log')\n",
                "plt.xscale('log')\n",
                "plt.show()\n",
                "\n",
            ],
