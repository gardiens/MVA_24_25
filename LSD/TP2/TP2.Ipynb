        },
        {
            "cell_type": "markdown",
            "id": "bac6ac99",
            "metadata": {},
            "source": ["### 3.5.1 \n", "On a pas été capable de trouver la solution "],
        },
        {
            "cell_type": "markdown",
            "id": "9d3dede4",
            "metadata": {},
            "source": [
                "### 3.5.2. Deduce an implementation of a parallel MM quadratic algorithm or minimizing f .\n",
                "Voir rapport pour la justification théorique",
            ],
        },
        {
            "cell_type": "code",
            "id": "1ff94a1e246733d8",
            "metadata": {
                "ExecuteTime": {
                    "end_time": "2025-01-27T18:08:17.280570Z",
                    "start_time": "2025-01-27T18:07:55.837957Z",
                }
            },
            "source": [
                "# Parallel MM Quadratic Algorithm\n",
                "abs_H = np.abs(H_sparse.copy().toarray()) \n",
                "sum_H = np.sum(abs_H, axis=1, keepdims=True) \n",
                "H_prime = abs_H * sum_H  \n",
                "H_prime_sum = np.sum(H_prime, axis=0)[:,np.newaxis]\n",
                "\n",
                "abs_G = np.abs(G_sparse.copy().toarray())  \n",
                "sum_G = np.sum(abs_G, axis=1, keepdims=True) \n",
                "G_prime = abs_G * sum_G \n",
                "\n",
                "\n",
                "def B(x,lambda_val = lambda_val, delta=delta):\n",
                "    return H_prime_sum + lambda_val * G_prime.T @ omega(G_sparse @ x, delta=delta)\n",
                "\n",
                "def parallel_mm_algorithm(grad_fun, metric_fun,stopping_criterion, theta=1,lambda_val = lambda_val, delta=delta):\n",
                "    x0 = np.zeros((N**2,1))\n",
                "    \n",
                "    history_f = [metric_fun(x0)]\n",
                "    history_df = [grad_fun(x0)]\n",
                "    x=x0\n",
                "    timer = Timer()\n",
                "    L_time = [timer()]\n",
                "    while stopping_criterion((history_df[-1], L_time[-1])):\n",
                "        grad_x  = grad_fun(x)\n",
                "        bx = B(x,lambda_val = lambda_val, delta=delta)\n",
                "        delta_x = -grad_x * (1/bx)\n",
                "        x = x + theta * delta_x\n",
                "        history_df.append(grad_x)\n",
                "        history_f.append(metric_fun(x))\n",
                "        L_time.append(timer())\n",
                "        \n",
                "    \n",
                "    return x,history_f,history_df,L_time\n",
                "\n",
                "\n",
                "def test_parallel_mm_algorithm(tmax=20,lambda_val = lambda_val, delta=delta):\n",
                "    stopping_criterion = lambda x : np.linalg.norm(x[0]) > np.sqrt(N)*1e-4 and x[1] <tmax\n",
                "    metric_fun = lambda x : f(x,y,G_sparse,H_sparse,lambda_val = lambda_val, delta=delta)\n",
                "    grad_fun = lambda x : gradient_f(x, H_sparse, G_sparse, y,lambda_val = lambda_val, delta=delta)\n",
                "    x_restaured,history,history_df,L_time = parallel_mm_algorithm(grad_fun, metric_fun,stopping_criterion,theta=1,lambda_val = lambda_val, delta=delta)\n",
                "    return x_restaured,history,history_df,L_time\n",
                "   \n",
                "x_restaured,history,history_df,L_time=test_parallel_mm_algorithm()\n",
                "plt.plot(L_time,history)\n",
                'plt.xlabel("time (s)")\n',
                'plt.ylabel("f values")\n',
                "plt.yscale('log')\n",
                "plt.xscale('log')\n",
                'plt.title("f over time")\n',
                "plt.show()\n",
                "\n",
                'plt.plot(L_time,np.linalg.norm(np.array(history_df), axis=1), label="norm of grad")\n',
                'plt.plot((L_time[0], L_time[-1]), np.sqrt(N)*1e-4 * np.ones((2,)), label="constraint")\n',
                'plt.xlabel("time (s)")\n',
                'plt.ylabel("norm_of_grad")\n',
                "plt.yscale('log')\n",
                'plt.title("norm of grad over time")\n',
                "plt.legend()\n",
                "plt.show()\n",
                "\n",
                "\n",
                'print("last f value", history[-1])\n',
